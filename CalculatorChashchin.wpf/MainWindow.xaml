<Window x:Class="CalculatorChashchin.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор" Height="420" Width="320"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="Display" Grid.Row="0"
                 FontSize="28" TextAlignment="Right"
                 VerticalContentAlignment="Center"
                 IsReadOnly="True" Text="0"/>
        <UniformGrid Grid.Row="1" Rows="5" Columns="4" Margin="0,10,0,0">
            <Button Content="C"   Click="Clear_Click"     FontSize="18"/>
            <Button Content="^"   Click="Operator_Click"  FontSize="18" Tag="^"/>
            <Button Content="←"   Click="Backspace_Click" FontSize="18"/>
            <Button Content="/"   Click="Operator_Click"  FontSize="18" Tag="/"/>
            <Button Content="7" Click="Digit_Click" FontSize="18"/>
            <Button Content="8" Click="Digit_Click" FontSize="18"/>
            <Button Content="9" Click="Digit_Click" FontSize="18"/>
            <Button Content="*" Click="Operator_Click" FontSize="18" Tag="*"/>
            <Button Content="4" Click="Digit_Click" FontSize="18"/>
            <Button Content="5" Click="Digit_Click" FontSize="18"/>
            <Button Content="6" Click="Digit_Click" FontSize="18"/>
            <Button Content="-" Click="Operator_Click" FontSize="18" Tag="-"/>
            <Button Content="1" Click="Digit_Click" FontSize="18"/>
            <Button Content="2" Click="Digit_Click" FontSize="18"/>
            <Button Content="3" Click="Digit_Click" FontSize="18"/>
            <Button Content="+" Click="Operator_Click" FontSize="18" Tag="+"/>
            <Button Content="±" Click="Sign_Click"   FontSize="18"/>
            <Button Content="0" Click="Digit_Click"  FontSize="18"/>
            <Button Content="." Click="Dot_Click"    FontSize="18"/>
            <Button Content="=" Click="Equals_Click" FontSize="18"/>
        </UniformGrid>
    </Grid>
</Window>
